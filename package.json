{
  "name": "3d-bim-viewer",
  "version": "1.0.0",
  "description": "Advanced 3D BIM model viewer supporting IFC, GLB, GLTF files with explode/assemble features",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node backend/server.js",
    "setup": "npm install",
    "test": "echo \"Tests will be implemented\"",
    "preview": "vite preview --config frontend/vite.config.ts"
  },
  "keywords": ["BIM", "3D", "IFC", "GLB", "GLTF", "Three.js", "ThatOpen", "web-ifc", "viewer"],
  "author": "3D BIM Viewer Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "@thatopen/components": "^3.1.0",
    "@thatopen/components-front": "^3.1.0",
    "@thatopen/fragments": "^3.1.1",
    "web-ifc": "^0.0.57",
    "@types/three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}